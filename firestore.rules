rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ============================================================
    // Default deny
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Phase 1 collections ----------

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /system_settings/{settingId} {
      allow read: if resource.data.public == true || isAdmin();
      allow write: if false; // Phase 4: only Cloud Functions may write
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /security_events/{eventId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ---------- Future collections — read-only, admin/user-scoped ----------

    // tasks — public read for active tasks, admin full read
    match /tasks/{taskId} {
      allow read: if (resource.data.active == true) || isAdmin();
      allow write: if false;
    }

    // task_submissions — owner + admin read
    match /task_submissions/{submissionId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // withdrawals — owner + admin read
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // referrals — referrer + referred + admin read
    match /referrals/{referralId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.referrerUid == request.auth.uid)
                  || (isAuthenticated() && resource.data.referredUid == request.auth.uid);
      allow write: if false;
    }

    // referral_targets — public read of active, admin full read
    match /referral_targets/{targetId} {
      allow read: if (resource.data.active == true) || isAdmin();
      allow write: if false;
    }

    // daily_bonuses — owner + admin read
    match /daily_bonuses/{bonusId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // spin_rewards — owner + admin read
    match /spin_rewards/{spinId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // giveaways — public read of active, admin full read
    match /giveaways/{giveawayId} {
      allow read: if (resource.data.active == true) || isAdmin();
      allow write: if false;
    }

    // promo_codes — ADMIN ONLY. Codes are secrets.
    match /promo_codes/{codeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // vip_memberships — owner + admin read
    match /vip_memberships/{vipId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // achievements — public read (definitions), admin read (all states)
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if false;
    }

    // notifications — user-scoped or broadcast, admin full read
    match /notifications/{notificationId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && (
                        resource.data.targetUid == request.auth.uid
                        || resource.data.targetAudience == 'all'
                      ));
      allow write: if false;
    }

    // support_tickets — owner + admin read
    match /support_tickets/{ticketId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}